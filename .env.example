# ---------- App ----------
# Public URL of the app. Local dev with HTTPS: https://localhost:3000
NEXT_PUBLIC_APP_URL=https://localhost:3000

# ---------- Supabase (Project Settings -> API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Buffer (https://publish.buffer.com/settings/api -> App Clients) ----------
BUFFER_CLIENT_ID=your-buffer-client-id
# Leave empty ONLY if you registered a PUBLIC client (PKCE only).
BUFFER_CLIENT_SECRET=your-buffer-client-secret
# Must match a Redirect URI registered on the Buffer client, character for character.
BUFFER_REDIRECT_URI=https://localhost:3000/api/buffer/callback

# ---------- Encryption ----------
# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
